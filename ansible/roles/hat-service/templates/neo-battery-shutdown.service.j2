[Unit]
Description=ConnectBox NEO Battery Shutdown Service
After=network.target
# pa-pulldown.service NOT required... now handled by RPi.GPIO calls

[Service]
Type=simple
# Print messages as they happen, so the journal shows events in order
# (buffered output only reached the log when the service exited)
Environment=PYTHONUNBUFFERED=1
ExecStart={{ hat_service_virtualenv_dir }}/bin/neo_batterylevelshutdown
Restart=on-failure

[Install]
WantedBy=basic.target
