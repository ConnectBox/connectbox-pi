# Web content (index.html sites copied onto the USB) often has links to pages
# that were never copied, e.g. GospelComics' "Previous Page" -> ../index.html.
# A broken link is sent back to the start page of the item it was clicked in,
# found from the Referer: .../assets/content/<lang>/html/<item>/... -> that
# item's folder.  Paths stay percent-encoded so they can go straight into a
# Location header.
map $http_referer $html_item_root {
    default "";
    "~^https?://[^/]+(?<item_root>/assets/content/[^/]+/html/[^/?#]+/)" $item_root;
}

# Where a broken web content link goes:
#   - no item in the Referer (typed URL, link from outside) -> ConnectBox home
#   - the item's own start page is the missing file          -> ConnectBox home
#     (redirecting it to itself would loop)
#   - otherwise                                              -> the item's start page
map "$html_item_root|$request_uri" $html_broken_link_target {
    "~^\|"                  /;
    "~^([^|]+)\|\1$"        /;
    "~^(?<target>[^|]+)\|"  $target;
}

# Kiwix HTML pages are changed on the way out (home button), but Kiwix's
# caching headers describe its original page: max-age=3600 plus an ETag that
# only identifies the ZIM.  Browsers would then keep pages without the button
# (or with an old one).  For HTML only, replace them with no-cache and no ETag;
# images, styles and scripts inside ZIMs keep Kiwix's caching.
map $upstream_http_content_type $kiwix_cache_control {
    "~^text/html"  "no-cache";
    default        $upstream_http_cache_control;
}
map $upstream_http_content_type $kiwix_etag {
    "~^text/html"  "";
    default        $upstream_http_etag;
}

server {
    listen 80;
    # Wildcard .local i.e. respond to anything that comes in on that domain
    #  which allows us to avoid calculating the mDNS name
    server_name {{connectbox_default_hostname}} .local connectbox;
    root {{ connectbox_enhanced_content_root }};
    index index.html;
    error_page 404 /index.html;
    access_log {{ connectbox_access_log }};
    error_log {{ connectbox_error_log }} error;
    rewrite_log on;


{{ nginx_chat_block }}
{{ nginx_admin_block }}

	location /admin {
      alias {{ connectbox_enhanced_admin_root }}/;
      add_header Cache-Control "no-cache";
	}


    location /content/ {
      alias {{ connectbox_usb_files_root }}/;
      # We need to override the default index.html because that file will be
      #  present for static sites, and if it exists, it stops the icon-only
      #  interface from rendering
      index .should_not_match_anything.html;
      autoindex on;
      autoindex_format json;
      charset utf-8;
      charset_types application/json;
      # Never cache the indexes
      location ~ /$ {
        expires -1;
      }
    }

    # Web content folders.  A missing file here must not fall through to the
    # server-wide "error_page 404 /index.html": that serves the app's page at
    # the wrong address, its scripts 404 and the reader sees a blank page.
    # Must come before the .json location so it wins for web content files.
    location ~ ^/assets/content/[^/]+/html/ {
      error_page 404 = @html_broken_link;
      # Floating button back to the ConnectBox menu on every web content page
      include snippets/connectbox_home_button.conf;
      location ~ \.json$ {
        expires -1;
      }
    }

    # ZIM files (offline websites) served by kiwix-serve (role "kiwix").
    #  - ^~ so the regex locations below (e.g. \.json$) never take ZIM files
    #    away from Kiwix (LibreTexts ZIMs broke without it);
    #  - Accept-Encoding "" so Kiwix sends plain HTML that nginx can add the
    #    home button to (nginx gzips the response itself).
    location ^~ /kiwix/ {
      proxy_pass http://127.0.0.1:{{ kiwix_port | default(8090) }};
      proxy_set_header Host $http_host;
      proxy_http_version 1.1;
      proxy_set_header Accept-Encoding "";
      proxy_hide_header Cache-Control;
      proxy_hide_header ETag;
      add_header Cache-Control $kiwix_cache_control;
      add_header ETag $kiwix_etag;
      include snippets/connectbox_home_button.conf;
    }

    location @html_broken_link {
      return 302 $html_broken_link_target;
    }

    location ~ \.json$ {
      expires -1;
    }

    # App code: make browsers check for a newer copy on every load, so patched
    # bundles (e.g. the 6.js goToDetails patch) reach clients straight away.
    location /build/ {
      add_header Cache-Control "no-cache";
    }

    # While mmiLoader builds new menus (a full USB index takes minutes), it
    # writes /tmp/connectbox-indexing.html.  Visitors opening the menu get that
    # "loading new content" page instead of an empty menu; it refreshes itself
    # and gives way to the menu when the file is removed at the end of the run.
    # Only the menu page is redirected - app code, admin, chat, Kiwix and media
    # are served as usual.
    location = /connectbox-indexing.html {
      root /tmp;
      add_header Cache-Control "no-store";
    }

    location / {
      if (-f /tmp/connectbox-indexing.html) {
        rewrite ^/(index\.html)?$ /connectbox-indexing.html last;
      }
      index index.html;
    }
}
